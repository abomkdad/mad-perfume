[Unit]
Description=Remove expired MAD recordings
After=mad-monitor.service
[Service]
Type=oneshot
User=madmonitor
Group=madmonitor
EnvironmentFile=/etc/mad-monitor/service.env
WorkingDirectory=/opt/mad-monitor/app/work/github-mad/cashier-monitor
ExecStart=/opt/mad-runtime/node-v24.21.0-linux-x64/bin/node scripts/retention-run.mjs
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict

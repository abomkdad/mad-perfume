[Unit]
Description=MAD cashier monitoring
After=network.target
[Service]
Type=simple
User=madmonitor
Group=madmonitor
WorkingDirectory=/opt/mad-monitor/app/work/github-mad/cashier-monitor
EnvironmentFile=/etc/mad-monitor/service.env
ExecStart=/opt/mad-runtime/node-v24.21.0-linux-x64/bin/node server.js
Restart=always
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/mad-monitor
ProtectHome=true
[Install]
WantedBy=multi-user.target
